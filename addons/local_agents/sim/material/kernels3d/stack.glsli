// What a cell's own matter presents at its faces: pressure, and the layer that touches them.
#ifndef LA_STACK_GLSLI
#define LA_STACK_GLSLI

// MEAN pressure over a cube face whose outward normal makes cosine `cos_ng` with gravity, Pa: the
// INTEGRAL over the face, never one sample at its centre. Gas in its exponential, condensed matter
// under it, six faces summing to m_total * g * edge at any scale height and any gravity direction.
float la_stack_face_p(float cos_ng, float edge, float g, float m_cond, float m_total, float p_mean) {
	if (!(m_total > 0.0) || !(g > 0.0) || !(p_mean > 0.0)) {
		return p_mean;
	}
	float m_gas = max(m_total - m_cond, 0.0);
	// The gas standing over the face, Pa, and its depth in scale heights. Bounded by its own weight,
	// so a cell at a millionth of a pascal states a face and not an infinity.
	float w = edge * m_gas * g * cos_ng;
	float u = w / p_mean;
	float gas = p_mean + 0.5 * w;
	if (u > 1.0e-4) {
		gas = w / (1.0 - exp(-u));
	} else if (u < -1.0e-4) {
		float e = exp(u);
		gas = w * e / (e - 1.0);
	}
	return gas + m_cond * g * 0.5 * edge * (1.0 + cos_ng);
}

// The layer at depth `z`: density in x, bulk modulus in y. Gas above (1 - f_cond) * edge, below it the
// CONDENSED FLUID at its own density and modulus. A lattice takes volume out of the cell and presents no
// layer: the fluid touching a face is what states it.
vec2 la_stack_layer(float z, float edge, float f_cond, float rho_cond, float rho_gas, float p_mean,
		float k_cond, float gamma) {
	float fc = clamp(f_cond, 0.0, 1.0);
	float z_gas = (1.0 - fc) * edge;
	if (clamp(z, 0.0, edge) > z_gas) {
		return vec2(max(rho_cond, 0.0), max(k_cond, 0.0));
	}
	return vec2(max(rho_gas, 0.0), gamma * max(p_mean, 0.0));
}

#endif
