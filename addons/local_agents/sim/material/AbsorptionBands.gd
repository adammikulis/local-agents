static var _edges: PackedFloat32Array = PackedFloat32Array()
static var _solar: PackedFloat32Array = PackedFloat32Array()
static var _packed: PackedFloat32Array = PackedFloat32Array()


static func edges_cm1() -> PackedFloat32Array:
	if _edges.is_empty():
		_edges.resize(BAND_COUNT + 1)
		for i in BAND_COUNT + 1:
			_edges[i] = float(EDGES_CM1[i])
	return _edges


## Temperature slice index and interpolation fraction for `t_k`, held flat outside the tabulated range.
## Returned as a Vector2 so a caller can hoist it out of its band loop.
static func slice_of(t_k: float) -> Vector2:
	if t_k <= float(TEMPS_K[0]):
		return Vector2(0.0, 0.0)
	if t_k >= float(TEMPS_K[TEMP_COUNT - 1]):
		return Vector2(float(TEMP_COUNT - 2), 1.0)
	var i: int = 0
	while i < TEMP_COUNT - 2 and t_k > float(TEMPS_K[i + 1]):
		i += 1
	var lo: float = float(TEMPS_K[i])
	return Vector2(float(i), (t_k - lo) / (float(TEMPS_K[i + 1]) - lo))


## Coefficient of band `b` at temperature `t_k`, linearly interpolated between slices and held flat
## outside them.
static func at(table: Array, b: int, t_k: float) -> float:
	if t_k <= float(TEMPS_K[0]):
		return float(table[b])
	if t_k >= float(TEMPS_K[TEMP_COUNT - 1]):
		return float(table[(TEMP_COUNT - 1) * BAND_COUNT + b])
	var i: int = 0
	while i < TEMP_COUNT - 2 and t_k > float(TEMPS_K[i + 1]):
		i += 1
	var lo: float = float(TEMPS_K[i])
	var f: float = (t_k - lo) / (float(TEMPS_K[i + 1]) - lo)
	return lerpf(float(table[i * BAND_COUNT + b]), float(table[(i + 1) * BAND_COUNT + b]), f)


## Share of the solar constant in band `b`. Derived from the solar blackbody, not tabulated; the
## outermost band keeps everything above its lower edge, so the weights sum to 1.
static func solar_weight(b: int) -> float:
	if _solar.is_empty():
		var e: PackedFloat32Array = edges_cm1()
		var c2: float = LAPhysical.PLANCK_C2_CM_K
		_solar.resize(BAND_COUNT)
		for i in BAND_COUNT:
			var lo: float = LARadiativeColumn.planck_above(c2 * e[i] / SOLAR_TEMPERATURE_K)
			var hi: float = 0.0
			if i < BAND_COUNT - 1:
				hi = LARadiativeColumn.planck_above(c2 * e[i + 1] / SOLAR_TEMPERATURE_K)
			_solar[i] = maxf(lo - hi, 0.0)
	return _solar[b]


## The GPU upload. Header, band edges, temperature slices, solar weights, then five coefficients per
## (temperature, band), then the Planck cumulative table. transport.glsl's RADIATE row reads this layout.
static func packed() -> PackedFloat32Array:
	if not _packed.is_empty():
		return _packed
	var e: PackedFloat32Array = edges_cm1()
	var out: PackedFloat32Array = PackedFloat32Array()
	out.resize(4 + (BAND_COUNT + 1) + TEMP_COUNT + BAND_COUNT + TEMP_COUNT * BAND_COUNT * 5 + CDF_COUNT)
	out[0] = float(BAND_COUNT)
	out[1] = float(CDF_COUNT)
	out[2] = CDF_XMAX
	out[3] = float(TEMP_COUNT)
	var o: int = 4
	for i in BAND_COUNT + 1:
		out[o + i] = e[i]
	o += BAND_COUNT + 1
	for i in TEMP_COUNT:
		out[o + i] = float(TEMPS_K[i])
	o += TEMP_COUNT
	for b in BAND_COUNT:
		out[o + b] = solar_weight(b)
	o += BAND_COUNT
	for t in TEMP_COUNT:
		for b in BAND_COUNT:
			var i: int = t * BAND_COUNT + b
			var k: int = o + i * 5
			out[k + 0] = float(CO2_LINE[i])
			out[k + 1] = float(CO2_CONT[i])
			out[k + 2] = float(CO2_CIA[i])
			out[k + 3] = float(H2O_LINE[i])
			out[k + 4] = float(H2O_CONT[i])
	o += TEMP_COUNT * BAND_COUNT * 5
	for i in CDF_COUNT:
		out[o + i] = LARadiativeColumn.planck_above(CDF_XMAX * float(i) / float(CDF_COUNT - 1))
	_packed = out
	return _packed
