// A CELL IS NOT A SUBSTANCE: rock, water and air at ONE temperature, in ONE volume. Native twin: LAMixtureEnthalpy,
// held equal by scripts/check_enthalpy_ssot.sh.

#ifndef LA_MIXTURE_ENTHALPY_GLSLI
#define LA_MIXTURE_ENTHALPY_GLSLI

// enthalpy.glsli must be included FIRST: a nested #include inside a .glsli is not expanded.
#ifndef LA_ENTHALPY_GLSLI
#error "include enthalpy.glsli before mixture_enthalpy.glsli"
#endif

// The temperature the last condensed phase leaves at: the frost point below the triple-point pressure,
// the boiling point above it. `has` is false when the substance has no vapour boundary at all.
float la_mix_vapour_boundary_c(SubstanceTh s, float p_pa, out bool has) {
	has = s.has_boil;
	if (!has) { return 0.0; }
	if (la_sublimes_at(s, p_pa)) { return la_sublimation_c_at(s, p_pa); }
	return la_boil_c_at(s, p_pa);
}

// The vapour pressure of the phase actually present: sublimation while the condensate is solid, saturation
// once it is liquid. Both are the SAME integrated Clausius-Clapeyron this table's latent heat anchors.
float la_mix_vapour_p_at(SubstanceTh s, float t_c, float p_pa, float molality_mol_kg) {
	float melt = la_melt_c_at(s, p_pa, molality_mol_kg);
	if (la_sublimes_at(s, p_pa) || (s.has_melt && t_c < melt)) {
		return la_sublimation_p_at(s, t_c);
	}
	return la_saturation_p_at(s, t_c);
}

// THE SATURATION SPLIT AT FIXED VOLUME, taking a vapour pressure the caller already solved:
// n_v = p_v(T) room / (R T), the rest stays condensed, and boiling is continuous — no plateau.
float la_mix_vapour_share(SubstanceTh s, float t_c, float m_kg, float room_m3, float p_v) {
	if (m_kg <= 0.0 || !s.has_boil) { return 0.0; }
	if (t_c >= s.crit_t_c) { return 1.0; }
	if (room_m3 <= 0.0 || s.molar_mass <= 0.0 || p_v <= 0.0) { return 0.0; }
	float t_k = max(t_c + LA_KELVIN_OFFSET, 1.0);
	return min(p_v * room_m3 / (LA_R_J_MOL_K * t_k) * s.molar_mass / m_kg, 1.0);
}

float la_mix_vapour_fraction(SubstanceTh s, float t_c, float p_pa, float m_kg, float room_m3,
		float molality_mol_kg) {
	return la_mix_vapour_share(s, t_c, m_kg, room_m3,
		la_mix_vapour_p_at(s, t_c, p_pa, molality_mol_kg));
}

// Specific enthalpy of one substance AS IT SITS IN THIS CELL: its own ladder's condensed branch and
// vapour branch at this temperature, mixed by the room's vapour share. Each branch is read at a pressure
// on its own side of the saturation curve, so the two are the ladder's and meet at the critical point.
float la_mix_specific_enthalpy(SubstanceTh s, float t_c, float p_pa, float m_kg, float room_m3,
		float molality_mol_kg) {
	if (!s.has_boil || t_c >= s.crit_t_c) { return la_state_to_enthalpy(s, t_c, p_pa, molality_mol_kg); }
	float p_v = la_mix_vapour_p_at(s, t_c, p_pa, molality_mol_kg);
	float f_v = la_mix_vapour_share(s, t_c, m_kg, room_m3, p_v);
	if (f_v >= 1.0) { return la_state_to_enthalpy(s, t_c, min(p_pa, p_v) * (1.0 - 1.0e-3), molality_mol_kg); }
	float h_cond = la_state_to_enthalpy(s, t_c, max(p_pa, p_v * (1.0 + 1.0e-3)), molality_mol_kg);
	if (f_v <= 0.0) { return h_cond; }
	float h_vap = la_state_to_enthalpy(s, t_c, min(p_pa, p_v) * (1.0 - 1.0e-3), molality_mol_kg);
	return mix(h_cond, h_vap, f_v);
}

// THE WHOLE CELL, from here down. A shader that solves one declares LA_MIX_SLOTS, the most entries a
// cell may hold, and defines the three hooks below; one that only asks about a single substance takes
// the per-substance half above and stops here.
#ifdef LA_MIX_SLOTS

// Solidus, liquidus and the vapour boundary, per entry.
#define LA_MIX_PTS (3 * LA_MIX_SLOTS)

// The includer's cell: its live entries, each substance's own table row and its mass in the reservoir
// being solved. The solver holds no fixed register set, so the entry count is the cell's.
int la_mix_n();
SubstanceTh la_mix_sub(int k);
float la_mix_mass(int k);

float la_mix_enthalpy_at(float t_c, float p_pa, float room_m3, float molality_mol_kg) {
	float h = 0.0;
	int n = la_mix_n();
	for (int i = 0; i < LA_MIX_SLOTS; ++i) {
		if (i >= n) { break; }
		float m = la_mix_mass(i);
		if (m > 0.0) {
			h += m * la_mix_specific_enthalpy(la_mix_sub(i), t_c, p_pa, m, room_m3, molality_mol_kg);
		}
	}
	return h;
}

// Every phase boundary of every substance present, ascending. Insertion sort: the list is at most three
// entries per substance and the walk needs them in the order a warming cell crosses them.
int la_mix_breakpoints(float p_pa, float molality_mol_kg, out float pts[LA_MIX_PTS]) {
	int count = 0;
	int n = la_mix_n();
	for (int i = 0; i < LA_MIX_SLOTS; ++i) {
		if (i >= n) { break; }
		if (la_mix_mass(i) <= 0.0) { continue; }
		SubstanceTh s = la_mix_sub(i);
		bool has = false;
		float cand[3] = float[3](
			s.has_melt ? la_melt_c_at(s, p_pa, molality_mol_kg) : 0.0,
			s.has_melt ? la_liquidus_c_at(s, p_pa, molality_mol_kg) : 0.0,
			la_mix_vapour_boundary_c(s, p_pa, has));
		bool live[3] = bool[3](s.has_melt, s.has_melt, has);
		for (int k = 0; k < 3; ++k) {
			if (!live[k] || count >= LA_MIX_PTS) { continue; }
			bool dup = false;
			for (int j = 0; j < count; ++j) { if (pts[j] == cand[k]) { dup = true; } }
			if (!dup) { pts[count++] = cand[k]; }
		}
	}
	for (int i = 1; i < count; ++i) {
		float v = pts[i];
		int j = i - 1;
		for (; j >= 0 && pts[j] > v; --j) { pts[j + 1] = pts[j]; }
		pts[j + 1] = v;
	}
	return count;
}

// The height of the discontinuity at a boundary, J: the fusion step of what is still condensed there.
// Boiling has no step at fixed volume — the vapour share climbs with the saturation pressure.
float la_mix_jump_of(SubstanceTh s, float m_kg, float t_b, float p_pa, float room_m3,
		float molality_mol_kg) {
	if (m_kg <= 0.0) { return 0.0; }
	float total = 0.0;
	float solidus = la_melt_c_at(s, p_pa, molality_mol_kg);
	float liquidus = la_liquidus_c_at(s, p_pa, molality_mol_kg);
	if (s.has_melt && solidus == t_b && liquidus == t_b) {
		float f_v = la_mix_vapour_fraction(s, t_b, p_pa, m_kg, room_m3, molality_mol_kg);
		total += m_kg * (1.0 - f_v) * s.l_fus;
	}
	return total;
}

float la_mix_jump_at(float t_b, float p_pa, float room_m3, float molality_mol_kg) {
	float total = 0.0;
	int n = la_mix_n();
	for (int i = 0; i < LA_MIX_SLOTS; ++i) {
		if (i >= n) { break; }
		total += la_mix_jump_of(la_mix_sub(i), la_mix_mass(i), t_b, p_pa, room_m3, molality_mol_kg);
	}
	return total;
}

// Illinois false position over a bracket the boundary walk already proved. Exact in one step where the
// segment is linear; the halving stops an end sticking where the saturation split makes it curve.
float la_mix_solve(float h_total_j, float p_pa, float room_m3, float molality_mol_kg, float lo, float hi) {
	float a = lo;
	float b = hi;
	float f_a = la_mix_enthalpy_at(a, p_pa, room_m3, molality_mol_kg) - h_total_j;
	float f_b = la_mix_enthalpy_at(b, p_pa, room_m3, molality_mol_kg) - h_total_j;
	float t = a;
	float width = b - a;
	for (int i = 0; i < 24; ++i) {
		float denom = f_b - f_a;
		t = abs(denom) > 0.0 ? a - f_a * (b - a) / denom : 0.5 * (a + b);
		t = clamp(t, a, b);
		float f_t = la_mix_enthalpy_at(t, p_pa, room_m3, molality_mol_kg) - h_total_j;
		if (f_t > 0.0) {
			b = t;
			f_b = f_t;
			f_a *= 0.5;
		} else {
			a = t;
			f_a = f_t;
			f_b *= 0.5;
		}
		// The bracket stopped shrinking: every further evaluation returns the same temperature.
		if (b - a >= width) { break; }
		width = b - a;
	}
	return t;
}

// THE CELL'S TEMPERATURE from its total enthalpy. `pinned` reports that the enthalpy landed inside a jump,
// and `progress` where in that jump it sits.
float la_mix_state(float h_total_j, float p_pa, float room_m3, float molality_mol_kg,
		out bool pinned, out float progress) {
	pinned = false;
	progress = 0.0;
	float pts[LA_MIX_PTS];
	int count = la_mix_breakpoints(p_pa, molality_mol_kg, pts);
	float lo = -LA_KELVIN_OFFSET;
	if (h_total_j <= la_mix_enthalpy_at(lo, p_pa, room_m3, molality_mol_kg)) {
		return lo;
	}
	float hi = lo;
	bool bracketed = false;
	for (int i = 0; i < LA_MIX_PTS; ++i) {
		if (i >= count) { break; }
		float t_b = pts[i];
		if (t_b <= lo) { continue; }
		float h_b = la_mix_enthalpy_at(t_b, p_pa, room_m3, molality_mol_kg);
		if (h_total_j <= h_b) {
			hi = t_b;
			bracketed = true;
			break;
		}
		float jump = la_mix_jump_at(t_b, p_pa, room_m3, molality_mol_kg);
		if (h_total_j < h_b + jump) {
			pinned = true;
			progress = jump > 0.0 ? (h_total_j - h_b) / jump : 0.0;
			return t_b;
		}
		lo = t_b;
	}
	if (!bracketed) {
		// Past the last boundary the curve only rises, so doubling the span always finds the far end.
		float span = 100.0;
		for (int i = 0; i < 64; ++i) {
			hi = lo + span;
			if (la_mix_enthalpy_at(hi, p_pa, room_m3, molality_mol_kg) >= h_total_j) {
				break;
			}
			span *= 2.0;
		}
	}
	return la_mix_solve(h_total_j, p_pa, room_m3, molality_mol_kg, lo, hi);
}

#endif   // LA_MIX_SLOTS

#endif
