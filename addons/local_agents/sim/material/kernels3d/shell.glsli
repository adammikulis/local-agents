// Radial shell table, model units, packed by LASphereGrid.shell_table(); gated by check_shell_table.sh.

#ifndef LA_SHELL_GLSLI
#define LA_SHELL_GLSLI

layout(set = 0, binding = 39, std430) restrict readonly buffer ShellGeom { float shell_geom[]; };

#define SHELL_STRIDE 4u
#define SHELL_DR     0u

float shell_dr(uint r) { return shell_geom[r * SHELL_STRIDE + SHELL_DR]; }

float shell_mid(uint r) { return shell_geom[r * SHELL_STRIDE + SHELL_MID]; }

float shell_d_out(uint r) { return shell_geom[r * SHELL_STRIDE + SHELL_D_OUT]; }

float shell_d_in(uint r) { return shell_geom[r * SHELL_STRIDE + SHELL_D_IN]; }

// Run across the RADIAL face in slot d; a lateral slot has no answer here.
float shell_run(uint r, uint d) { return d == N_IN ? shell_d_in(r) : shell_d_out(r); }

#endif
