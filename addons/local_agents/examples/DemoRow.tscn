[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://addons/local_agents/examples/DemoRow.gd" id="1_row"]

[node name="DemoRow" type="PanelContainer"]
script = ExtResource("1_row")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 10

[node name="Row" type="HBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Text" type="VBoxContainer" parent="Margin/Row"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 4

[node name="Title" type="Label" parent="Margin/Row/Text"]
unique_name_in_owner = true
layout_mode = 2

[node name="Description" type="Label" parent="Margin/Row/Text"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.72, 0.74, 0.78, 1)
autowrap_mode = 3

[node name="Requirements" type="Label" parent="Margin/Row/Text"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.72, 0.4, 1)
autowrap_mode = 3

[node name="Launch" type="Button" parent="Margin/Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(120, 0)
layout_mode = 2
size_flags_vertical = 4
