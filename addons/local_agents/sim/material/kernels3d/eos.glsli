// A cell's pressure: its gas in the room its condensed volume B leaves, B squeezed at compressibility C,
// both off Birch-Murnaghan below.
#ifndef LA_EOS_GLSLI
#define LA_EOS_GLSLI

// Birch-Murnaghan (Birch 1947, Phys. Rev. 71:809; fourth order, Birch 1978, JGR 83:1257), strain
// f = ((V0/V)^(2/3)-1)/2: P = 3 K0 f (1+2f)^(5/2) (1 + a f + b4 f^2), a = 3/2(K0'-4), b4 zero at third order.
// Native twin LAPhaseEos.cpp. v0(1 - P/K) has no root at P ~ K.
float la_bm_p(float f, float k0, float a, float b4) {
	float u = 1.0 + 2.0 * f;
	return 3.0 * k0 * f * u * u * sqrt(u) * (1.0 + a * f + b4 * f * f);
}

float la_bm_dp(float f, float k0, float a, float b4) {
	float u = 1.0 + 2.0 * f;
	return 3.0 * k0 * u * sqrt(u) * ((u + 5.0 * f) * (1.0 + a * f + b4 * f * f) + f * u * (a + 2.0 * b4 * f));
}

// Newton inside the bracket [lo, hi] where P(f) rises; NaN for a pressure the bracket cannot reach.
float la_bm_strain_in(float p_pa, float k0, float a, float b4, float lo, float hi) {
	if (!(k0 > 0.0) || p_pa == 0.0) {
		return 0.0;
	}
	if (p_pa < la_bm_p(lo, k0, a, b4) || p_pa > la_bm_p(hi, k0, a, b4)) {
		return uintBitsToFloat(0x7FC00000u);
	}
	float f = clamp(p_pa / (3.0 * k0), lo, hi);
	for (int i = 0; i < 20; ++i) {
		float r = la_bm_p(f, k0, a, b4) - p_pa;
		if (r > 0.0) { hi = f; } else { lo = f; }
		if (hi - lo <= 4.0 * LA_FLOAT_EPS * (1.0 + abs(f))) {
			break;
		}
		float d = la_bm_dp(f, k0, a, b4);
		float step = d > 0.0 ? f - r / d : 0.5 * (lo + hi);
		f = (step > lo && step < hi) ? step : 0.5 * (lo + hi);
	}
	return f;
}

// Third order, bracketed at the turning points of P(f), 9a f^2 + (7 + 2a) f + 1 = 0.
float la_bm_strain(float p_pa, float k0, float kprime) {
	float a = 1.5 * (kprime - 4.0);
	float lo = -0.45;
	float hi = 1.5;
	float disc = (7.0 + 2.0 * a) * (7.0 + 2.0 * a) - 36.0 * a;
	if (a != 0.0 && disc > 0.0) {
		float s = sqrt(disc);
		float r1 = (-(7.0 + 2.0 * a) + s) / (18.0 * a);
		float r2 = (-(7.0 + 2.0 * a) - s) / (18.0 * a);
		lo = r1 < 0.0 ? max(lo, r1) : lo;
		hi = r1 < 0.0 ? hi : min(hi, r1);
		lo = r2 < 0.0 ? max(lo, r2) : lo;
		hi = r2 < 0.0 ? hi : min(hi, r2);
	}
	return la_bm_strain_in(p_pa, k0, a, 0.0, lo, hi);
}

float la_bm_squeeze(float f) {
	float u = 1.0 + 2.0 * f;
	return 1.0 / (u * sqrt(u));
}

// K_T = -V dP/dV = (1 + 2f) dP/df / 3, Pa.
float la_bm_k_t(float f, float k0, float a, float b4) {
	return (1.0 + 2.0 * f) * la_bm_dp(f, k0, a, b4) / 3.0;
}

// LA_APPROX: peng_robinson_fluid
// Peng-Robinson gas in the room V - B + C (p - p_ref), s_a = sum n_i sqrt(a_i), s_b = sum n_i b_i. Native
// twin LAPhaseEosFn::mixture_pressure.
float la_eos_p(float vol, float a_gas_rt, float s_a, float s_b, float b_vol, float c_comp, float p_ref) {
	if (vol <= 0.0) {
		return 0.0;
	}
	if (c_comp <= 0.0) {
		float room = vol - b_vol;
		return room > s_b ? a_gas_rt / (room - s_b) - s_a * s_a / (room * room + 2.0 * s_b * room - s_b * s_b) : 0.0;
	}
	// No gas at all: the condensed phases alone are squeezed into the cell.
	if (a_gas_rt <= 0.0) {
		return p_ref + (b_vol - vol) / c_comp;
	}
	float k = vol - b_vol - s_b - c_comp * p_ref;
	float disc = sqrt(k * k + 4.0 * c_comp * a_gas_rt);
	float p_id = (k > 0.0) ? 2.0 * a_gas_rt / (k + disc) : (disc - k) / (2.0 * c_comp);
	if (s_a <= 0.0) {
		return p_id;
	}
	float lo = p_ref + (s_b - vol + b_vol) / c_comp;
	float hi = max(p_id, lo + abs(lo) * 4.0 * LA_FLOAT_EPS + 1.0);
	for (int i = 0; i < 64; ++i) {
		float room = vol - b_vol + c_comp * (hi - p_ref);
		float r = hi - (a_gas_rt / (room - s_b) - s_a * s_a / (room * room + 2.0 * s_b * room - s_b * s_b));
		if (r >= 0.0) { break; }
		hi = lo + 2.0 * (hi - lo);
	}
	for (int i = 0; i < 64; ++i) {
		float mid = 0.5 * (lo + hi);
		float room = vol - b_vol + c_comp * (mid - p_ref);
		float r = mid - (a_gas_rt / (room - s_b) - s_a * s_a / (room * room + 2.0 * s_b * room - s_b * s_b));
		if (r < 0.0) { lo = mid; } else { hi = mid; }
		if (hi - lo <= 4.0 * LA_FLOAT_EPS * abs(hi)) {
			break;
		}
	}
	return 0.5 * (lo + hi);
}
#endif
