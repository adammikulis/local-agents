// The one definition of the neighbour-slot layout. Held equal to LASphereGrid by
// scripts/check_neighbour_slots.sh, which also bans bare integer indices into nbr[]/send[].

#ifndef LA_NEIGHBOURS_GLSLI
#define LA_NEIGHBOURS_GLSLI

const uint N_IN  = 0u;    // inward / down; -1 at the shell floor
const uint N_OUT = 1u;    // outward / up;  -1 at the shell top
const uint N_A0  = 2u;
const uint N_A1  = 3u;
const uint N_B0  = 4u;
const uint N_B1  = 5u;

const uint N_LAT0 = 2u;            // lateral index l is slot N_LAT0 + l; link_arc/link_tan use the same l
const uint N_LATERAL_COUNT = 4u;
const uint N_SLOTS = 6u;

uint opposite(uint d) { return d ^ 1u; }

#endif
