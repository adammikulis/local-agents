#!/usr/bin/env bash
# BLOCKS A COMMIT WHILE ANY GATE IS RED.
#
# Two commits went out over a genuinely failing gate on 2026-08-11, both times under a message describing
# care, because the exit code was never read — only the tail of the output.
#
# The cause was self-inflicted. check_comment_claims had been given a ceiling BELOW its count, so lint
# failed on every run by design. A permanently red light carries no signal, and the two real failures were
# read as that background. Ceilings are ratchets: set at the count, lowered as things are fixed, never
# raised to turn a light green.
#
# Bypass with `git commit --no-verify` only when you MEAN to record a broken tree.
set -uo pipefail
# Git exports these into a hook and they override any `git -C <path>` a gate runs, so a cross-worktree
# query answers about the committing repo instead. Gates must see a clean environment.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR
ROOT="$(git rev-parse --show-toplevel)"
[ -x "$ROOT/scripts/agent_harness.sh" ] || exit 0

# A merge that brings extension sources leaves bin/ built from the old ones, and every engine gate refuses it.
. "$ROOT/scripts/lib_godot.sh"
if ! la_extension_current "$ROOT" >/dev/null 2>&1; then
  echo "pre-commit: bin/ does not match the extension sources; building."
  "$ROOT/addons/local_agents/gdextensions/localagents/scripts/build_extension.sh" >/dev/null 2>&1 \
    || { echo "COMMIT BLOCKED: build_extension.sh failed."; exit 1; }
fi

if [ -x "$ROOT/scripts/check_comment_ratio.sh" ] && ! "$ROOT/scripts/check_comment_ratio.sh"; then
  echo "COMMIT BLOCKED: more comment than code."
  exit 1
fi
# A BARE lint IS THE FAST TIER: no gate in it starts an engine. The slow tier launches a real Godot holding the
# machine-wide GPU lock, which a commit may not wait on; scripts/integrate.sh runs the slow gates a landing
# affects, and CI runs `lint --all`.
out="$("$ROOT/scripts/agent_harness.sh" lint 2>&1)"
rc=$?
if [ "$rc" -ne 0 ]; then
  printf '%s\n' "$out" | grep -E "LINT_FAIL|^FAIL |ERROR:" | head -12
  echo
  echo "COMMIT BLOCKED: agent_harness.sh lint exited $rc."
  exit 1
fi
exit 0
