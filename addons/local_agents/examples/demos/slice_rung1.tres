[gd_resource type="Resource" script_class="LocalAgentDemoEntry" load_steps=2 format=3]

[ext_resource type="Script" path="res://addons/local_agents/examples/DemoEntry.gd" id="1_entry"]

[resource]
script = ExtResource("1_entry")
order = 131
title = "Slice, rung 1: gravity"
description = "The same box as rung 0 with one process added: the potential of the mass that is there, solved on the device, and the tide every other declared body raises on it. Arrows over every open cell draw the whole pull a mass here falls under, and the key beside them gives the magnitude they saturate at; run it with --vectors=tide and the arrows draw the tidal part alone, two lobes that stand toward the Moon and away from it and sweep past as the body turns under them. A test mass released two kilometres over the ground falls under the same field and stops on the rock; the readout carries the local g at the probe, its speed and how long it fell, and G drops another wherever you are standing. Beside it the tide readout gives the height water standing on the total equipotential reaches at this site and the angle of the body raising it from overhead: both run through a full cycle twice in each of the body's days. Hold R to charge a throw and let go to lob an orb along your look direction ([ and ] halve and double the speed): it leaves the hand with the ground's own rotation and bends into the same field from the moment it is let go, drawing the path it took. The solve is also what gives the seed a vertical, so the water the body was given soaks into the rock under it. Nothing else moves: no wind, no flow, no heat spreading."
scene_path = "res://addons/local_agents/examples/SliceRung1Demo.tscn"
requires_model = false
requires_voxel_backend = true
