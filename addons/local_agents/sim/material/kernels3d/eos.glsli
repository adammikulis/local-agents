// PRESSURE IS A STATE FUNCTION OF THE CELL, not a path integral up a column.
// The phases share one cell and are in mechanical equilibrium, so one pressure satisfies
//     V = sum_gas n R T / p  +  sum_cond m v(T, p)
// with the condensed specific volume LASubstances.density inverts to,
//     v(T, p) = v0(T) * (1 - (p - p_std) / K),  v0(T) = (1 + alpha (T - T_ref)) / rho_ref.
// Multiplying through by p gives one quadratic, so the root is closed form and O(1) per cell:
//     C p^2 + (V - B - C p_std) p - A = 0
// A = N_gas R T, B = sum m v0(T), C = sum m v0(T) / K. A substance with no declared bulk modulus is
// incompressible: it takes its unstressed volume and adds nothing to C.
#ifndef LA_EOS_GLSLI
#define LA_EOS_GLSLI

float la_eos_p(float vol, float a_gas_rt, float b_vol, float c_comp, float p_std) {
	if (vol <= 0.0) {
		return 0.0;
	}
	// Nothing compressible: the gas fills what the condensed phases leave.
	if (c_comp <= 0.0) {
		float room = vol - b_vol;
		return room > 0.0 ? a_gas_rt / room : 0.0;
	}
	// No gas: the condensed phases alone are squeezed into the cell.
	if (a_gas_rt <= 0.0) {
		return p_std + (b_vol - vol) / c_comp;
	}
	float k = vol - b_vol - c_comp * p_std;
	return (sqrt(k * k + 4.0 * c_comp * a_gas_rt) - k) / (2.0 * c_comp);
}
#endif
