[resource]
script = ExtResource("1_entry")
order = 130
title = "Slice, rung 0: state"
description = "One box of the planet, laid on the real terrain and stepped by the bottom rung alone: matter, energy and phase; nothing moves. No gravity is solved, no pressure stands and no wind blows, so the vector glyphs are off and the picture is the state the world was seeded into."
