#ifndef LA_FACEAREA_GLSLI
#define LA_FACEAREA_GLSLI

layout(set = 0, binding = 42, std430) restrict readonly buffer FaceArea { float face_area[]; };  // model units^2

// Wall between cell c and its slot-d neighbour; all six slots are real faces. Needs neighbours.glsli.
float face_area_of(uint c, uint d) {
	return face_area[c * N_SLOTS + d];
}

#endif
