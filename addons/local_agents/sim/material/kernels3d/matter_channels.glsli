// THE MATTER CHANNELS, bound in LAMatterChannels.CHANNELS order. One declaration: a kernel that weighs a
// cell's contents and a kernel that sources gravity from them must read the same amounts off the same
// bindings, or one substance gravitates and the other does not.

#ifndef LA_MATTER_CHANNELS_GLSLI
#define LA_MATTER_CHANNELS_GLSLI

const int LA_CHANNEL_SLOTS = 26;   // LAMatterChannels.KERNEL_SLOTS

layout(set = 0, binding = LA_BIND_H2O, std430) restrict readonly buffer H2O { float h2o[]; };
layout(set = 0, binding = LA_BIND_SILICATE, std430) restrict readonly buffer Silicate { float silicate[]; };
layout(set = 0, binding = LA_BIND_CARBONATE, std430) restrict readonly buffer Carbonate { float carbonate[]; };
layout(set = 0, binding = LA_BIND_SILICA, std430) restrict readonly buffer Silica { float silica[]; };
layout(set = 0, binding = LA_BIND_O2, std430) restrict readonly buffer O2 { float o2[]; };
layout(set = 0, binding = LA_BIND_CO2, std430) restrict readonly buffer Co2 { float co2[]; };
layout(set = 0, binding = LA_BIND_N2, std430) restrict readonly buffer N2 { float n2[]; };
layout(set = 0, binding = LA_BIND_BIOMASS, std430) restrict readonly buffer Biomass { float biomass[]; };
layout(set = 0, binding = LA_BIND_FUNGUS, std430) restrict readonly buffer Fungus { float fungus[]; };
layout(set = 0, binding = LA_BIND_DETRITUS, std430) restrict readonly buffer Detritus { float detritus[]; };
layout(set = 0, binding = LA_BIND_FUEL, std430) restrict readonly buffer Fuel { float fuel[]; };
layout(set = 0, binding = LA_BIND_ORG_H, std430) restrict readonly buffer OrgH { float org_h[]; };
layout(set = 0, binding = LA_BIND_ORG_O, std430) restrict readonly buffer OrgO { float org_o[]; };
layout(set = 0, binding = LA_BIND_FERT, std430) restrict readonly buffer Fert { float fert[]; };
layout(set = 0, binding = LA_BIND_METAL, std430) restrict readonly buffer Metal { float metal[]; };
layout(set = 0, binding = LA_BIND_OLIVINE, std430) restrict readonly buffer Olivine { float olivine[]; };
layout(set = 0, binding = LA_BIND_PYROXENE, std430) restrict readonly buffer Pyroxene { float pyroxene[]; };
layout(set = 0, binding = LA_BIND_PLAGIOCLASE, std430) restrict readonly buffer Plagioclase { float plagioclase[]; };
layout(set = 0, binding = LA_BIND_HALITE, std430) restrict readonly buffer Halite { float halite[]; };
layout(set = 0, binding = LA_BIND_APATITE, std430) restrict readonly buffer Apatite { float apatite[]; };
layout(set = 0, binding = LA_BIND_H2, std430) restrict readonly buffer H2 { float h2[]; };
layout(set = 0, binding = LA_BIND_CO, std430) restrict readonly buffer Co { float co[]; };
layout(set = 0, binding = LA_BIND_SO2, std430) restrict readonly buffer So2 { float so2[]; };
layout(set = 0, binding = LA_BIND_H2S, std430) restrict readonly buffer H2s { float h2s[]; };
layout(set = 0, binding = LA_BIND_CH4, std430) restrict readonly buffer Ch4 { float ch4[]; };
layout(set = 0, binding = LA_BIND_H2O_PORE, std430) restrict readonly buffer H2OPore { float h2o_pore[]; };

// Amount of channel `i` at cell `c`, mol/m^3.
float channel_at(int i, uint c) {
	switch (i) {
		case 0:  return h2o[c];
		case 1:  return silicate[c];
		case 2:  return carbonate[c];
		case 3:  return silica[c];
		case 4:  return o2[c];
		case 5:  return co2[c];
		case 6:  return n2[c];
		case 7:  return biomass[c];
		case 8:  return fungus[c];
		case 9:  return detritus[c];
		case 10: return fuel[c];
		case 11: return org_h[c];
		case 12: return org_o[c];
		case 13: return fert[c];
		case 14: return metal[c];
		case 15: return olivine[c];
		case 16: return pyroxene[c];
		case 17: return plagioclase[c];
		case 18: return halite[c];
		case 19: return apatite[c];
		case 20: return h2[c];
		case 21: return co[c];
		case 22: return so2[c];
		case 23: return h2s[c];
		case 24: return ch4[c];
		case 25: return h2o_pore[c];
	}
	return 0.0;
}

#endif
