// =====================================================================================================
// THE ONE DEFINITION OF A CELL'S SIZE. `#include "cell_geom.glsli"`.
//
// WHY THIS FILE EXISTS. This grid's cells are NOT the same size: a column near a cube-face centre subtends
// more solid angle than one at a corner, and a cell high in the shell is wider than one at the floor
// because lateral spacing is an arc growing with radius. The volume ratio is gated by
// scripts/check_sphere_grid.sh, and it grows with resolution.
//
// Two things follow:
//   - A SUM of a per-cell channel value is not an amount of anything.
//   - A TRANSFER of "0.3 of a cell" into a differently sized cell delivers a different amount of matter
//     than it debited. Matter created and destroyed, every advection step, every channel.
//
// It exists as an include for the reason rc_shared.glsli does: written once per kernel it would be
// written five ways, and a gate on the CONSTANTS cannot see a divergent FORMULA.
//
// WHAT THE INCLUDER MUST PROVIDE — this is textual, like rc_shared.glsli, and reads one buffer by name:
//
//     layout(set = 0, binding = 17, std430) restrict readonly buffer SolidAngle { float solid_angle[]; };
//
// indexed by SURFACE cell (cell / depth), steradians, built by LASphereGrid. Binding 17 by convention;
// 15 is the neighbour table and 16 is link_tan.
//
// UNITS: model units. `cell_size` is the radial thickness of one layer; `core_radius` the radius of the
// innermost shell's inner face. Multiply a volume by METRES_PER_MODEL_UNIT^3 to reach SI.
// =====================================================================================================

// Inner and outer radius of the shell `cell` sits in. Cell centres are at +0.5 (LASphereGrid.cell_world_pos),
// so layer r spans [core_radius + r*cell_size, core_radius + (r+1)*cell_size].
float cg_inner_radius(uint cell, uint depth, float core_radius, float cell_size) {
	return core_radius + float(cell % depth) * cell_size;
}

float cg_outer_radius(uint cell, uint depth, float core_radius, float cell_size) {
	return core_radius + float(cell % depth + 1u) * cell_size;
}

// VOLUME of a cell, model units cubed. Integrating r^2 dr over the shell gives (r_out^3 - r_in^3)/3, which
// is exact — a mid-radius approximation is not, and the error it makes is the same shape as the bug this
// file exists to remove.
float cg_cell_volume(uint cell, uint depth, float core_radius, float cell_size) {
	float ri = cg_inner_radius(cell, depth, core_radius, cell_size);
	float ro = cg_outer_radius(cell, depth, core_radius, cell_size);
	return solid_angle[cell / depth] * (ro * ro * ro - ri * ri * ri) / 3.0;
}

// Area of the OUTWARD radial face — what an upward flux crosses.
float cg_face_area_outward(uint cell, uint depth, float core_radius, float cell_size) {
	float ro = cg_outer_radius(cell, depth, core_radius, cell_size);
	return solid_angle[cell / depth] * ro * ro;
}

// Area of the INWARD radial face. Smaller than the outward one by (r_in/r_out)^2, which is exactly why a
// radial transport that ignores area does not conserve.
float cg_face_area_inward(uint cell, uint depth, float core_radius, float cell_size) {
	float ri = cg_inner_radius(cell, depth, core_radius, cell_size);
	return solid_angle[cell / depth] * ri * ri;
}

// THE CONSERVATIVE TRANSFER FACTOR, and the reason most of this file exists.
//
// Channels store an INTENSIVE quantity — a per-cell-volume amount. Moving a value `x` out of `src` and
// adding the same `x` to `dst` conserves only when the two cells are the same size, and on this grid they
// are not: it silently multiplies the moved matter by vol(src)/vol(dst).
//
// So a kernel that debits `x` from src must credit `x * cg_transfer(src, dst, ...)` to dst. The matter
// moved is `x * vol(src)` either way; this is only the change of denominator.
float cg_transfer(uint src, uint dst, uint depth, float core_radius, float cell_size) {
	float vd = cg_cell_volume(dst, depth, core_radius, cell_size);
	return (vd > 0.0) ? (cg_cell_volume(src, depth, core_radius, cell_size) / vd) : 0.0;
}
