// THE DRIFT AND DIFFUSION CLOSURES. Each says how fast one phase travels RELATIVE to the mixture the
// face flux carries, or what diffusivity a face presents. Include after flux.glsl's buffers and the
// Params block.

#ifndef LA_CLOSURES_GLSLI
#define LA_CLOSURES_GLSLI

const float KELVIN = 273.15;                        // LAPhysical.KELVIN_OFFSET
const float STEFAN = 5.670374419e-8;                // LAPhysical.STEFAN_BOLTZMANN
const float KOZENY_CARMAN_C = 180.0;                // LAPhysical.KOZENY_CARMAN_C
const float SMAGORINSKY_COEFF = 0.1650789493;       // LAPhysical.SMAGORINSKY_COEFF
const float AIR_DENSITY = 1.225;                    // LAPhysical.AIR_DENSITY_KG_M3
const float EPS0 = 8.8541878128e-12;                // LAPhysical.VACUUM_PERMITTIVITY_F_M
const float RREA_THRESHOLD = 2.84e5;                // LAPhysical.RREA_THRESHOLD_V_M
const float CLOUD_COND = 1.0e-14;                   // LAPhysical.CLOUD_CONDUCTIVITY_S_M
const float CLEAR_AIR_COND = 1.0e-13;               // LAPhysical.CLEAR_AIR_CONDUCTIVITY_S_M
const float CHANNEL_COND = 1.0e4;                   // LAPhysical.LIGHTNING_CHANNEL_CONDUCTIVITY_S_M
const float CHARGING_LWC = 1.0e-3;                  // LAPhysical.CHARGING_LWC_KG_M3
const float NIC_CHARGE_RATE = 1.0e-9;               // LAPhysical.NIC_CHARGE_RATE_C_M3_S
const float CHARGE_ZONE_WARM_C = -10.0;             // LAPhysical.CHARGE_ZONE_WARM_C
const float CHARGE_ZONE_COLD_C = -25.0;             // LAPhysical.CHARGE_ZONE_COLD_C
const float CONVECTIVE_UPDRAFT = 10.0;              // LAPhysical.CONVECTIVE_UPDRAFT_M_S
const float MELT_VISC = 100.0;                      // LAPhysical.BASALT_MELT_VISCOSITY_PA_S
const float ROSCOE_N = 2.5;                         // LAPhysical.EINSTEIN_ROSCOE_EXPONENT
const float LOCKUP_CRYSTAL_FRAC = 0.6;              // LAPhysical.RHEOLOGICAL_LOCKUP_CRYSTAL_FRAC
const float DIFFUSIVITY = 1.66;                     // LAPhysical.TWO_STREAM_DIFFUSIVITY
const float C2_CM_K = 1.4387768775;                 // LAPhysical.PLANCK_C2_CM_K
const float KAPPA_REF_PA = 1.0e4;                   // LAPhysical.ABSORPTION_REF_PRESSURE_PA
const float R_CO2 = 188.924269;                     // LAPhysical.CO2_GAS_CONST_J_KGK
const float SUTHERLAND_K = 110.4;                   // LASubstances.n2.viscosity_sutherland_k
const float AIR_VISC_REF_T_C = 15.0;                // LASubstances.n2.viscosity_ref_t_c
const float AIR_VISC_REF = 1.81e-5;                 // LASubstances.n2.viscosity_pa_s
const float WATER_VISC_REF = 1.002e-3;              // LASubstances.h2o.viscosity_pa_s
const float WATER_VISC_REF_T_C = 20.0;              // LASubstances.h2o.viscosity_ref_t_c
const float VOGEL_B = 247.8;                        // LASubstances.h2o.viscosity_vogel_b_k
const float VOGEL_C = 140.0;                        // LASubstances.h2o.viscosity_vogel_c_k
const float GRAIN_DRAG = 1.0;                       // LAPhysical.GRAIN_DRAG_COEFF
const float CLOUD_R_EFF = 1.0e-5;                   // LAPhysical.CLOUD_DROPLET_R_EFF_M
const float CLOUD_ASYM = 0.85;                      // LAPhysical.CLOUD_ASYMMETRY
const float WATER_TRIPLE_T_C = 0.01;                // LAPhysical.WATER_TRIPLE_T_C
const float WATER_CRIT_T_C = 373.946;               // LAPhysical.WATER_CRITICAL_T_C
const float R_VAPOUR = 461.52;                      // LAPhysical.VAPOUR_GAS_CONST_J_KGK
const float M_H2O = 0.018015;                       // LASubstances.h2o.molar_mass
const float M_O2 = 0.0319988;                       // LASubstances.o2.molar_mass
const float M_N2 = 0.0280134;                       // LASubstances.n2.molar_mass
const float M_H2 = 0.00201588;                      // LASubstances.h2.molar_mass
const float M_CO2 = 0.0440095;                      // LASubstances.co2.molar_mass
const float M_CH4 = 0.01604276;                     // LASubstances.ch4.molar_mass
const float M_CO = 0.0280104;                       // LASubstances.co.molar_mass
const float M_SO2 = 0.0640588;                      // LASubstances.so2.molar_mass
const float M_H2S = 0.03407588;                     // LASubstances.h2s.molar_mass
const float RHO_SILICATE = 2900.0;                  // LASubstances.silicate.density
const float M_SILICATE = 0.1161612;                 // LASubstances.silicate.molar_mass
const float RHO_CELLULOSE = 500.0;                  // LASubstances.cellulose.density
const float M_CELLULOSE = 0.030026;                 // LASubstances.cellulose.molar_mass
// mol/m^3 at which a cell is FULL of a substance; amount/full is its volume fraction of the cell.
const float FULL_SILICATE = RHO_SILICATE / M_SILICATE;
const float FULL_CELLULOSE = RHO_CELLULOSE / M_CELLULOSE;
const float ALBEDO_GROUND = 0.15;                   // LAPhysical.ALBEDO_BARE_GROUND
const float ALBEDO_WATER = 0.06;                    // LAPhysical.ALBEDO_OCEAN
const float ALBEDO_ICE = 0.65;                      // LAPhysical.ALBEDO_SNOW_ICE
const float ALBEDO_VEG = 0.12;                      // LAPhysical.ALBEDO_VEGETATION
const float EMIS_WATER = 0.96;                      // LAPhysical.EMISSIVITY_WATER
const float EMIS_SNOW = 0.99;                       // LAPhysical.EMISSIVITY_SNOW
const float EMIS_ROCK = 0.95;                       // LAPhysical.BASALT_EMISSIVITY
const float R_GAS = 8.314462618;                    // LAPhysical.GAS_CONSTANT_J_MOL_K
const float LAMBDA_HYDRO = 3.0;                     // LAPhysical.ESCAPE_PARAM_HYDRODYNAMIC
const float XUV_EFF = 0.15;                         // LAPhysical.XUV_HEATING_EFFICIENCY
const float SQRT_PI = sqrt(radians(180.0));
const int GHOST_SPACE = -2;                         // LAFieldBoundary3D.SPACE_REDIRECT
const float C_LIGHT = 299792458.0;                  // LAPhysical.SPEED_OF_LIGHT_M_S
const float N2_DIAMETER = 3.64e-10;                 // LAPhysical.N2_KINETIC_DIAMETER_M
const float AVOGADRO = 6.02214076e23;               // LAPhysical.AVOGADRO_PER_MOL
const float KNUDSEN_LIMIT = 0.1;                    // LAPhysical.KNUDSEN_CONTINUUM_LIMIT


// kg/m^3 the cell's own liquid water stands at.
layout(set = 0, binding = LA_BIND_H2O_PORE, std430) readonly buffer H2OPoreBuf { float h2o_pore[]; };
layout(set = 0, binding = LA_BIND_WATER_RHO, std430) readonly buffer WaterRhoBuf { float water_rho[]; };

vec3 g_at(uint c) {
	return vec3(g_field[c * 3u], g_field[c * 3u + 1u], g_field[c * 3u + 2u]);
}

vec3 vel_at(uint c) {
	return vec3(vel_x[c], vel_y[c], vel_z[c]);
}

// Outward unit normal of face d. Slot order -X,+X,-Y,+Y,-Z,+Z.
vec3 face_normal(uint d) {
	float s = (d & 1u) == 1u ? 1.0 : -1.0;
	uint axis = d >> 1u;
	return vec3(axis == 0u ? s : 0.0, axis == 1u ? s : 0.0, axis == 2u ? s : 0.0);
}

float t_k(uint c) {
	return max(temp[c] + KELVIN, 1.0);
}

// Ideal-gas air density from the cell's own pressure and temperature, kg/m^3.
float air_rho(uint c) {
	return gas_r[c] > 0.0 ? max(pressure[c], 0.0) / (gas_r[c] * t_k(c)) : 0.0;
}

// Gas viscosity, Pa s: Sutherland's law, mu = mu_ref (T_ref+S)/(T+S) (T/T_ref)^1.5.
float air_visc(uint c) {
	float t = t_k(c);
	float tr = AIR_VISC_REF_T_C + KELVIN;
	return AIR_VISC_REF * (tr + SUTHERLAND_K) / (t + SUTHERLAND_K) * pow(t / tr, 1.5);
}

// Liquid water's viscosity, Pa s, over the range it is liquid in: the Vogel form.
float water_visc(uint c) {
	float t = clamp(temp[c], WATER_TRIPLE_T_C, WATER_CRIT_T_C) + KELVIN;
	float tr = WATER_VISC_REF_T_C + KELVIN;
	return WATER_VISC_REF * pow(10.0, VOGEL_B / (t - VOGEL_C) - VOGEL_B / (tr - VOGEL_C));
}

// The full potential of a cell, J/kg.
float la_phi(uint c) { return grav_phi[c] + grav_ref[c]; }

// The cell's own grain diameter, or the row's seed where the cell declares none, m.
float grain_d_at(uint c) {
	return grain[c] > 0.0 ? grain[c] : params.grain_d;
}

// kg one mole of this row's substance weighs: pure density over the full amount. 0 for a row that
// carries no matter, whose max_fill is +inf.
float sub_kg_mol() {
	return params.max_fill > 0.0 ? params.density / params.max_fill : 0.0;
}

// THE ONE EMPTINESS TEST, the same one state_derive.glsl empties a cell on: no matter at all.
bool no_matter(uint c) {
	return !(rho_bulk[c] > 0.0);
}

// THE MATTER THAT MOVES, kg/m^3: the cell's mass less the lattice grains standing in it.
float rho_fluid(uint c) {
	return max(rho_bulk[c] - max(lithic_kg[c], 0.0), 0.0);
}

// The cell's h2o split by the shares the enthalpy ladder derived, mol/m^3.
float h2o_ice(uint c)    { return max(h2o[c], 0.0) * clamp(h2o_solid[c], 0.0, 1.0); }
float h2o_water(uint c)  { return max(h2o[c], 0.0) * clamp(h2o_liquid[c], 0.0, 1.0); }
float h2o_gas(uint c)    { return max(h2o[c], 0.0) * clamp(h2o_vapour[c], 0.0, 1.0); }

// CONDENSED cloud water, droplets and ice alike, kg/m^3.
float cloud_water_kg_m3(uint c) {
	return (h2o_water(c) + h2o_ice(c)) * M_H2O;
}

// Gas molecules per m^3 in the cell, every gas channel summed.
float gas_number_density(uint c) {
	return (h2o_gas(c) + max(co2[c], 0.0) + max(ch4[c], 0.0) + max(co_gas[c], 0.0) + max(so2[c], 0.0)
		+ max(h2s[c], 0.0) + max(o2_gas[c], 0.0) + max(n2_gas[c], 0.0) + max(h2_gas[c], 0.0)) * AVOGADRO;
}

// PAST THE CONTINUUM THERE IS NO FLUID: a cell whose gas has a mean free path past the Knudsen limit
// of its own edge holds molecules on ballistic paths; its faces are walls to the fluid below.
bool collisionless(uint c) {
	// A ghost tail cell is a prescribed state with no edge to hold a mean free path against.
	if (c >= params.cell_count) {
		return false;
	}
	float n = gas_number_density(c);
	float sigma = sqrt(2.0) * radians(180.0) * N2_DIAMETER * N2_DIAMETER;
	return cloud_water_kg_m3(c) <= 0.0 && n * sigma * cell_edge[c] * KNUDSEN_LIMIT < 1.0;
}

// Volume the cell's liquid water fills, and the volume all its condensed h2o fills, as fractions.
float water_vol_frac(uint c) {
	return water_rho[c] > 0.0 ? clamp(h2o_water(c) * M_H2O / water_rho[c], 0.0, 1.0) : 0.0;
}

float h2o_cond_frac(uint c) {
	return water_rho[c] > 0.0 ? clamp(cloud_water_kg_m3(c) / water_rho[c], 0.0, 1.0) : 0.0;
}

// Volume fraction of the cell that is condensed, so a beam meets it geometrically.
float condensed_frac(uint c) {
	float f = solid[c] != 0.0 ? 1.0 : 0.0;
	f += max(lithic_frac[c], 0.0) + h2o_cond_frac(c);
	return clamp(f, 0.0, 1.0);
}

// mol/m^3 a cell full of its own liquid water would hold, at that water's own density.
float full_h2o_at(uint c) {
	return water_rho[c] / M_H2O;
}

float ice_vol_frac(uint c) {
	return max(h2o_cond_frac(c) - water_vol_frac(c), 0.0);
}

// Cloud optical depth over `len` m: tau = 3 LWP / (2 rho_w r_eff), the Q = 2 limit for droplets far
// larger than the wavelength (Stephens 1978, J. Atmos. Sci. 35:2111). Its condensed VOLUME fraction is
// a millionth, so a beam meeting it geometrically passes through. LA_APPROX: fixed_cloud_droplet_radius
float cloud_tau(uint c, float len) {
	float lwp = cloud_water_kg_m3(c) * len;
	return (lwp > 0.0 && water_rho[c] > 0.0) ? 1.5 * lwp / (water_rho[c] * CLOUD_R_EFF) : 0.0;
}

// Conservative-scattering two-stream reflectance, R = tau(1-g) / (2 + tau(1-g)).
float cloud_reflectance(uint c) {
	float t = cloud_tau(c, cell_edge[c]) * (1.0 - CLOUD_ASYM);
	return t / (2.0 + t);
}

// Volume fraction the water in the rock's pores fills; a locked cell's fluid is there, not free.
float pore_water_vol_frac(uint c) {
	return water_rho[c] > 0.0 ? clamp(max(h2o_pore[c], 0.0) * M_H2O / water_rho[c], 0.0, 1.0) : 0.0;
}

// Shares of the cell's fluid room that are liquid water (x) and gas (y). Ice carries nothing.
vec2 pore_shares(uint c) {
	float w = water_vol_frac(c) + pore_water_vol_frac(c);
	float gas = max(1.0 - max(lithic_frac[c], 0.0) - h2o_cond_frac(c), 0.0);
	float tot = w + gas;
	return tot > 0.0 ? vec2(w, gas) / tot : vec2(0.0);
}

// Density of the fluid this cell's grains are carried by, kg/m^3.
float carrier_rho(uint c) {
	vec2 sh = pore_shares(c);
	return sh.x * water_rho[c] + sh.y * air_rho(c);
}

// Mass of the condensed phases THE FLUID CARRIES per unit cell volume, kg/m^3: what lies at the
// bottom of it. The lattice's grains bear their own weight and stand outside the fluid's head.
float cond_kg_m3(uint c) {
	return cloud_water_kg_m3(c);
}

// Non-inductive charge separation in the riming band, C/m^3 this step: the pair creates nothing.
float separation_dq(uint c, vec3 up, float dt) {
	float band = clamp((CHARGE_ZONE_WARM_C - temp[c]) / (CHARGE_ZONE_WARM_C - CHARGE_ZONE_COLD_C),
		0.0, 1.0);
	float wet = clamp(cloud_water_kg_m3(c) / CHARGING_LWC, 0.0, 1.0);
	float lift = clamp(dot(vel_at(c), up) / CONVECTIVE_UPDRAFT, 0.0, 1.0);
	return NIC_CHARGE_RATE * band * wet * lift * dt;
}

// --- the cell's own hydrostatic stack --------------------------------------------------------------

// How far face d lies below the cell's centre, in half-edges: the face's DEPTH IN THIS CELL'S OWN
// stack, so the cell's six faces present its own weight back and nothing else's.
float face_cos(uint c, uint d) {
	vec3 gv = g_at(c);
	float gm = length(gv);
	return gm > 0.0 ? dot(face_normal(d), gv) / gm : 0.0;
}

// Potential of n minus c across face d of c, J/kg: the pair's gravity integrated over the centre
// distance. Never a difference of two full potentials, which float32 cannot hold at a body's radius.
float la_dphi(uint c, uint n, uint d) {
	return -dot(0.5 * (g_at(c) + g_at(n)), face_normal(d)) * la_face_dist(c, int(n));
}

// Depth of face d below the cell's top, m, over the cell's OWN edge.
float face_z(uint c, uint d) {
	return 0.5 * cell_edge[c] * (1.0 + face_cos(c, d));
}

// THE GAS ALONE at face d, Pa: the gas column in its exponential over the cell. Condensed water is a
// band under it that the water pair states for itself (band.glsli), never a layer the gas presents.
float face_p(uint c, uint d) {
	vec3 gv = g_at(c);
	float gm = length(gv);
	if (gm <= 0.0) {
		return max(pressure[c], 0.0);
	}
	float m_gas = max(rho_fluid(c) - cond_kg_m3(c), 0.0);
	return la_stack_face_p(face_cos(c, d), cell_edge[c], gm, 0.0, m_gas, max(pressure[c], 0.0));
}

float face_p_gas(uint c, uint d) {
	return face_p(c, d);
}

vec2 face_layer(uint c, uint d) {
	float pg = max(face_p_gas(c, d), 0.0);
	float r = gas_r[c];
	return r > 0.0 ? vec2(pg / (r * t_k(c)), gas_gamma[c] * pg) : vec2(0.0);
}

// --- the water band -------------------------------------------------------------------------------

// Unit vector down the cell's own vertical, or zero where nothing pulls.
vec3 down_at(uint c) {
	vec3 gv = g_at(c);
	float gm = length(gv);
	return gm > 0.0 ? gv / gm : vec3(0.0);
}

// The water this cell's band holds, m^3: its liquid water at the liquid's own density.
float water_m3(uint c) {
	float e = cell_edge[c];
	return water_vol_frac(c) * e * e * e;
}

// Depth of the free surface below the cell centre, m; +inf where there is no water or no vertical.
float water_top(uint c) {
	float vol = water_m3(c);
	vec3 gd = down_at(c);
	if (vol <= 0.0 || gd == vec3(0.0)) {
		return 1.0e30;
	}
	return la_band_top(gd, 0.5 * cell_edge[c], ground_d[c], vol);
}

// Face d's wet share (x), ground share (y) and the water's mean pressure over the wet share (z), Pa.
vec3 water_face(uint c, uint d, float top) {
	vec3 gd = down_at(c);
	if (gd == vec3(0.0)) {
		// No vertical: the liquid is dispersed, and wets every face by its volume share.
		float e = cell_edge[c];
		return vec3(min(water_m3(c) / (e * e * e), 1.0), 0.0, max(pressure[c], 0.0));
	}
	if (top >= 1.0e29) {
		return vec3(0.0, 0.0, 0.0);
	}
	vec3 f = la_band_face(gd, face_normal(d), 0.5 * cell_edge[c], top, ground_d[c]);
	float p_w = max(pressure[c], 0.0) + water_rho[c] * length(g_at(c)) * f.z;
	return vec3(f.x, f.y, p_w);
}

float water_c(uint c) {
	float k = max(k_cond[c], 0.0);
	return (k > 0.0 && water_rho[c] > 0.0) ? sqrt(k / water_rho[c]) : 0.0;
}

float water_z(uint c) {
	float k = max(k_cond[c], 0.0);
	return (k > 0.0 && water_rho[c] > 0.0) ? sqrt(k * water_rho[c]) : 0.0;
}

// Signal speed of the layer at face d, m/s: sqrt(K/rho) of what touches it, never a mixture mean.
float face_c(uint c, uint d) {
	vec2 lay = face_layer(c, d);
	return (lay.x > 0.0 && lay.y > 0.0) ? sqrt(lay.y / lay.x) : 0.0;
}

// Impedance rho*c of the layer at face d, kg/(m^2 s).
float impedance(uint c, uint d) {
	vec2 lay = face_layer(c, d);
	return (lay.x > 0.0 && lay.y > 0.0) ? sqrt(lay.x * lay.y) : 0.0;
}

// THE SONIC STATE of a gas layer (p, c, u along the normal) expanding into vacuum: velocity (x) and
// pressure (y) of the exact rarefaction, u* = c* = (2c + (gamma-1) u)/(gamma+1), p* = p (c*/c)^(2g/(g-1)).
vec2 la_sonic_vacuum(float p, float c, float u, float gam) {
	if (!(c > 0.0) || !(p > 0.0)) {
		return vec2(max(u, 0.0), 0.0);
	}
	float cs = (2.0 * c + (gam - 1.0) * u) / (gam + 1.0);
	if (cs <= 0.0) {
		return vec2(0.0, 0.0);
	}
	if (u >= c) {
		return vec2(u, p);
	}
	return vec2(cs, p * pow(cs / c, 2.0 * gam / (gam - 1.0)));
}

// --- eddy viscosity --------------------------------------------------------------------------------

// Area-weighted velocity across one slot, and the centre distance to it. The cell's own at a wall.
vec3 slot_vel(uint c, uint d, out float dist) {
	float a = 0.0;
	vec3 av = vec3(0.0);
	float ad = 0.0;
	for (uint f = la_slot_lo(c, d); f < la_slot_hi(c, d); ++f) {
		int nb = nbr[f];
		if (nb < 0) { nb = ghost[f]; }
		if (nb < 0) { continue; }
		float w = la_face_area(c, nbr[f]);
		a += w;
		av += w * vel_at(uint(nb));
		ad += w * la_face_dist(c, nbr[f]);
	}
	if (a <= 0.0) {
		dist = 0.5 * cell_edge[c];
		return vel_at(c);
	}
	dist = ad / a;
	return av / a;
}

// Magnitude of the resolved strain-rate tensor, 1/s: |S| = sqrt(2 S_ij S_ij).
float strain_rate(uint c) {
	mat3 grad = mat3(0.0);
	for (uint a = 0u; a < 3u; ++a) {
		uint slot = a * 2u;
		float dlo = 0.0;
		float dhi = 0.0;
		vec3 vlo = slot_vel(c, slot, dlo);
		vec3 vhi = slot_vel(c, opposite_slot(slot), dhi);
		vec3 d = (vhi - vlo) / max(dlo + dhi, 1.0e-30);
		grad[0][a] = d.x;
		grad[1][a] = d.y;
		grad[2][a] = d.z;
	}
	float s2 = 0.0;
	for (uint i = 0u; i < 3u; ++i) {
		for (uint j = 0u; j < 3u; ++j) {
			float sij = 0.5 * (grad[i][j] + grad[j][i]);
			s2 += 2.0 * sij * sij;
		}
	}
	return sqrt(s2);
}

// Smagorinsky eddy viscosity, m^2/s: nu_t = (C_s dx)^2 |S| plus that fluid's molecular floor.
float eddy_viscosity_of(uint c, float rho, float mu) {
	float mixing = SMAGORINSKY_COEFF * cell_edge[c];
	float nu_mol = rho > 0.0 ? mu / rho : 0.0;
	return nu_mol + mixing * mixing * strain_rate(c);
}

float eddy_viscosity(uint c) {
	vec2 sh = pore_shares(c);
	return sh.x * eddy_viscosity_of(c, water_rho[c], water_visc(c))
		+ sh.y * eddy_viscosity_of(c, air_rho(c), air_visc(c));
}

// Einstein-Roscoe: the melt's own viscosity times the crystal framework it is carrying, Pa s.
float melt_viscosity(uint c) {
	float crystal = 1.0 - clamp(silicate_melt[c], 0.0, 1.0);
	float r = clamp(crystal / LOCKUP_CRYSTAL_FRAC, 0.0, 0.9999);
	return MELT_VISC * pow(1.0 - r, -ROSCOE_N);
}

// --- drift velocities ------------------------------------------------------------------------------

// Terminal settling velocity of a grain of diameter `d`, m/s: Ferguson & Church 2004, J. Sediment. Res.
// 74:933 eq. 4, w = R g d^2 / (18 nu + sqrt(0.75 C2 R g d^3)) -- Stokes at small d, the drag law at large.
float grain_settling(uint c, float d, float rho, float mu) {
	float rg = max(params.density - rho, 0.0) * length(g_at(c));
	if (rg <= 0.0 || d <= 0.0) {
		return 0.0;
	}
	// No fluid is no terminal velocity: the grain and the cell fall together under the body force.
	float den = 18.0 * mu + sqrt(0.75 * GRAIN_DRAG * rg * rho * d * d * d);
	return den > 0.0 ? rg * d * d / den : 0.0;
}

// Grain drift, m/s: each fluid's rate over its share of the room.
float settling_speed(uint c) {
	if ((params.flags & TF_SETTLE) == 0u) {
		return 0.0;
	}
	vec2 sh = pore_shares(c);
	float d = grain_d_at(c);
	return sh.x * grain_settling(c, d, water_rho[c], water_visc(c))
		+ sh.y * grain_settling(c, d, air_rho(c), air_visc(c));
}

// The fastest a grain here could settle: a substep count is bounded by the quicker fluid.
float settling_speed_max(uint c) {
	float d = grain_d_at(c);
	return max(grain_settling(c, d, water_rho[c], water_visc(c)),
		grain_settling(c, d, air_rho(c), air_visc(c)));
}

// Share of grains a fluid holds up. u* = sqrt(nu_t |S|) is the friction velocity, which in a boundary
// layer is the scale of the vertical turbulent fluctuations (Bagnold: suspension once u* > w_s).
float suspended_share(uint c, float rho, float mu) {
	float w_s = grain_settling(c, grain_d_at(c), rho, mu);
	if (w_s <= 0.0) {
		return 1.0;      // no denser than its fluid, so nothing pulls it out
	}
	return clamp(sqrt(max(eddy_viscosity_of(c, rho, mu) * strain_rate(c), 0.0)) / w_s, 0.0, 1.0);
}

// Hydraulic resistance of half a cell to pore flow, the reciprocal of its Kozeny-Carman permeability.
// An OPEN cell has no matrix and resists nothing; rock with no pore space is impermeable.
float darcy_resistance(uint c) {
	if (solid[c] == 0.0) {
		return 0.0;
	}
	float phi = clamp(porosity[c], 0.0, 0.999);
	if (phi <= 0.0) {
		return 1.0e30;
	}
	float d = grain_d_at(c);
	float k = d * d * phi * phi * phi / (KOZENY_CARMAN_C * max((1.0 - phi) * (1.0 - phi), 1.0e-12));
	return 1.0 / max(k, 1.0e-30);
}

// Darcy velocity across the bond, m/s per unit head gradient: two half-cells in series, K = rho g k/mu.
float darcy_conductivity(uint a, uint b) {
	float r = 0.5 * (darcy_resistance(a) + darcy_resistance(b));
	if (r <= 0.0) {
		return 0.0;
	}
	// Each pore fluid conducts on its own weight over its own viscosity, over its share of the pore.
	vec2 sh = pore_shares(a);
	float mob = 0.0;
	if (sh.x > 0.0 && water_visc(a) > 0.0) { mob += sh.x * water_rho[a] / water_visc(a); }
	if (sh.y > 0.0 && air_visc(a) > 0.0) { mob += sh.y * air_rho(a) / air_visc(a); }
	return mob * length(g_at(a)) / r;
}

// --- the electric column ---------------------------------------------------------------------------

// Gauss's law along the field line: charge integrated outward is a surface charge, so a field. V/m.
float column_field(uint c) {
	vec3 gv = g_at(c);
	if (length(gv) <= 0.0) {
		return 0.0;
	}
	vec3 up = -normalize(gv);
	float sigma = 0.0;
	uint at = c;
	// A straight walk never revisits a cell, so the box is the bound.
	for (uint i = 0u; i < params.cell_count; ++i) {
		if (solid[at] != 0.0) {
			break;
		}
		sigma += charge[at] * la_step_len(up, cell_edge[at]);
		int nx = la_step(at, up);
		if (nx < 0) {
			break;
		}
		at = uint(nx);
	}
	return abs(sigma) / EPS0;
}

// Relativistic runaway breakdown field at this cell, V/m: the threshold falls with air density.
float rrea_threshold(uint c) {
	if (pressure[c] <= 0.0) {
		return 0.0;
	}
	return RREA_THRESHOLD * air_rho(c) / AIR_DENSITY;
}

// Past the runaway threshold the local air density sets, the dielectric stops being one: the
// conductivity jumps to a return-stroke channel's. `e` is this cell's column field.
float ohmic_conductivity_at(uint c, float e) {
	float ambient = mix(CLEAR_AIR_COND, CLOUD_COND,
		clamp(cloud_water_kg_m3(c) / CHARGING_LWC, 0.0, 1.0));
	float threshold = rrea_threshold(c);
	return (threshold > 0.0 && e >= threshold) ? CHANNEL_COND : ambient;
}

// --- the space face --------------------------------------------------------------------------------

float wind_term(float n, float m, float m_max) {
	return m < m_max ? max(n, 0.0) * m : 0.0;   // kg/m^3 the wind lifts; a bound species adds none
}

// LAW_ESCAPE: the box edge is space. Bound gas: Jeans tail effusion (Jeans 1925; Chamberlain & Hunten
// 1987), tail excess out via `tail_j_mol`; unbound: the XUV energy-limited wind (Watson et al. 1981;
// Erkaev et al. 2007). LA_APPROX: top_cell_exobase
float escape_speed(uint c, uint d, out float tail_j_mol) {
	tail_j_mol = 0.0;
	vec3 gv = g_at(c);
	float gmag = length(gv);
	float depth = -(la_phi(c) + params.phi_datum);
	float kg_mol = sub_kg_mol();
	if (gmag <= 0.0 || depth <= 0.0 || kg_mol <= 0.0) {
		return 0.0;
	}
	vec3 up = -gv / gmag;
	float cosf = dot(up, face_normal(d));
	if (cosf <= 0.0) {
		return 0.0;
	}
	float tk = t_k(c);
	float lam = kg_mol * depth / (R_GAS * tk);
	float v_eff = 0.0;
	if (lam >= LAMBDA_HYDRO) {
		v_eff = sqrt(2.0 * R_GAS * tk / kg_mol) / (2.0 * SQRT_PI) * (1.0 + lam) * exp(-lam);
		tail_j_mol = R_GAS * tk * ((lam * lam + 2.0 * lam + 2.0) / (lam + 1.0) - 1.5);
	} else {
		vec3 sun = vec3(params.sun_x, params.sun_y, params.sun_z);
		float sl = length(sun);
		if (sl <= 0.0) {
			return 0.0;
		}
		float mu = dot(up, sun / sl);
		if (mu <= 0.0) {
			return 0.0;
		}
		float m_max = LAMBDA_HYDRO * R_GAS * tk / depth;
		float rho_wind = wind_term(h2o_gas(c), M_H2O, m_max) + wind_term(co2[c], M_CO2, m_max)
			+ wind_term(ch4[c], M_CH4, m_max) + wind_term(co_gas[c], M_CO, m_max)
			+ wind_term(so2[c], M_SO2, m_max) + wind_term(h2s[c], M_H2S, m_max)
			+ wind_term(o2_gas[c], M_O2, m_max) + wind_term(n2_gas[c], M_N2, m_max)
			+ wind_term(h2_gas[c], M_H2, m_max);
		if (rho_wind <= 0.0) {
			return 0.0;
		}
		v_eff = XUV_EFF * params.xuv_w_m2 * mu / (depth * rho_wind);
	}
	return v_eff * cosf;
}

#endif
